[sub_resource type="GDScript" id="GDScript_b7y51"]
resource_name = "randomize_flag"
script/source = "@tool
extends MeshInstance3D

#3*7 - 1 for zero index. Modify this value and same in shader if the number of flags changes.
const MAX_ATLAS_INDEX = 21-1

# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	var mat : ShaderMaterial = material_override

	var rand_index := randi_range(0, MAX_ATLAS_INDEX)
	mat.set_shader_parameter(\"flag_index\", rand_index)
	
# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	pass
"

